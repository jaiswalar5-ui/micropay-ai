# =====================================================
# MicroPay AI — Environment Configuration Template
# =====================================================

# Server Port
PORT=4020
NODE_ENV=development

# x402 Protocol Network Identifier (EIP-155 CAIP-2)
# eip155:84532 = Base Sepolia Testnet
# eip155:8453  = Base Mainnet
NETWORK=eip155:84532

# Payout Destination Address (The address that receives micropayments)
# Replace with your testnet EVM address
PAYMENT_RECEIVER_ADDRESS=0xd407e409E34E0b9afb99EcCeb609bDbcD5e7f1bf

# USDC Token Contract on Base Sepolia
USDC_ASSET_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Official x402 Facilitator Endpoint
FACILITATOR_URL=https://x402.org/facilitator

# AI Model Provider Credentials (Optional)
# If provided, Google Gemini 2.5 Flash will be invoked.
# If left blank, MicroPay AI seamlessly uses its high-quality heuristic extractive NLP engine
# with clear labelling indicating fallback mode.
GEMINI_API_KEY=

# Allowed CORS Origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
