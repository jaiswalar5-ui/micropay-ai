# MicroPay AI - Backend Environment Configuration

# Server Port
PORT=4020
NODE_ENV=development

# x402 Payment Configuration
# Network CAIP-2 identifier (eip155:84532 is Base Sepolia testnet)
NETWORK=eip155:84532

# Receiver address for x402 micropayments (Replace with your EVM address)
PAYMENT_RECEIVER_ADDRESS=0xd407e409E34E0b9afb99EcCeb609bDbcD5e7f1bf

# Base Sepolia Circle USDC Contract Address
USDC_ASSET_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Facilitator URL for x402 on-chain settlement & verification
FACILITATOR_URL=https://x402.org/facilitator

# AI Provider Credentials (Optional)
# If provided, real Google Gemini models (gemini-2.5-flash) will be called.
# If omitted, MicroPay AI seamlessly uses its high-quality local heuristic extractive NLP pipeline,
# with clear labelling so users and evaluators know fallback mode is active.
GEMINI_API_KEY=

# Allowed CORS Origins (comma separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
